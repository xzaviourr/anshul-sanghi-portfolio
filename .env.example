# Server-only: supplied when you connect a private Blob store in Vercel.
# Never prefix this with VITE_ or put it in frontend code.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Server-only admin password (16-256 characters). Generate with: openssl rand -hex 32
# Add it in Vercel for Production and redeploy. Never prefix it with VITE_.
WISHBOARD_ADMIN_PASSWORD=
